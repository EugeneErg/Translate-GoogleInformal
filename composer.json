{
  "name": "eugene-erg/google-informal-icu-i18n-translate",
  "description": "Text translation using multiple neural network APIs",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "EugeneErg\\GoogleInformalIcuI18nTranslator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "require": {
    "psr/simple-cache": "^3.0",
    "ext-intl": "*",
    "eugene-erg/icu-i18n-translator": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "psr/http-client": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpunit/phpunit": "^12.5"
  }
}
